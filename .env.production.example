# ──────────── 服务器环境变量 ────────────
# 服务端口
PORT=5000

# 允许的前端来源（CORS + Socket.IO），生产部署改为实际域名
CLIENT_ORIGIN=http://localhost:5000

# SQLite 数据库路径（留空 = server/db/gwent.db）
DB_PATH=

# ──────────── Ollama AI 配置 ────────────
# 服务器本地 Ollama 地址
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen-gwent-agent
OLLAMA_TEMPERATURE=0.3
OLLAMA_TIMEOUT=10000
